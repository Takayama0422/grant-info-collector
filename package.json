{
  "name": "grant-info-collector",
  "version": "0.1.0",
  "private": true,
  "description": "e-Govデータポータルの公開データから補助金・助成金・公募関連の情報を収集し、CSV/XLSXへ整形する自動化ツール",
  "scripts": {
    "collect": "node src/cli.js --config config/sources.json --output reports/runs --timestamp",
    "test": "node --test --test-concurrency=1",
    "validate": "for f in src/*.js tests/*.js; do node --check \"$f\" || exit 1; done",
    "collect:offline": "node src/cli.js --config config/sources.json --output reports/runs --timestamp --offline"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
